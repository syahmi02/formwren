{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Form file, format version 1",
  "type": "object",
  "required": ["formatVersion", "id", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/dottedId" },
    "title": { "type": "string" },
    "script": { "type": "string" },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/typedValue" }
    },
    "result": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/typedValue" }
    },
    "events": { "$ref": "#/$defs/handlers" },
    "datasets": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataset" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "variables": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/typedValue" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "dottedId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "columnType": {
      "enum": ["string", "int", "decimal", "float", "boolean", "date", "datetime"]
    },
    "handlers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/identifier" }
    },
    "typedValue": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/columnType" },
        "default": {}
      }
    },
    "column": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/columnType" },
        "label": { "type": "string" },
        "size": { "type": "integer", "minimum": 1 },
        "precision": { "type": "integer", "minimum": 1 },
        "scale": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" },
        "min": { "type": ["number", "string"] },
        "max": { "type": ["number", "string"] },
        "pattern": { "type": "string" },
        "version": { "type": "boolean" }
      }
    },
    "row": {
      "type": "object"
    },
    "dataset": {
      "type": "object",
      "required": ["id", "columns"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "confirmUnsaved": { "type": "boolean" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "initialRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/row" }
        },
        "sampleRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/row" }
        }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "type", "layout"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" },
        "layout": { "$ref": "#/$defs/layout" },
        "props": { "type": "object" },
        "bind": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "events": { "$ref": "#/$defs/handlers" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "z": { "type": "integer" }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "Grid" } }
          },
          "then": {
            "required": ["props"],
            "properties": { "props": { "$ref": "#/$defs/gridProps" } }
          }
        }
      ]
    },
    "gridProps": {
      "type": "object",
      "required": ["columns", "recordRows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gridTrack" }
        },
        "headerRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/gridRow" }
        },
        "recordRows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gridRow" }
        },
        "footerRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/gridRow" }
        }
      }
    },
    "gridTrack": {
      "type": "object",
      "required": ["id", "width"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "frozen": { "enum": ["left"] }
      }
    },
    "gridRow": {
      "type": "object",
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/gridCell" }
        }
      }
    },
    "gridCell": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "field": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "pattern": "^=" },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "colSpan": { "type": "integer", "minimum": 1 },
        "format": { "type": "string" },
        "editor": { "enum": ["text", "number", "dropdown", "date", "checkbox"] },
        "kind": { "enum": ["rowStatus", "rowSelect"] },
        "options": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": ["string", "number", "boolean", "null"] },
                  "label": { "type": "string" }
                }
              }
            }
          ]
        },
        "optionValue": { "$ref": "#/$defs/identifier" },
        "optionLabel": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
